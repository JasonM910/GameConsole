# Rutas públicas; Vite y Nginx redirigen /api al servicio Go.
VITE_GAMESTATS_URL=/api/events
VITE_GAMESTATS_STATS_URL=/api/stats
# Desarrollo con Compose: usar el puerto publicado por web (Go es interno).
# Sin Docker, cambiar a http://127.0.0.1:8080 y ejecutar Go y Scala.
GAMESTATS_PROXY_TARGET=http://127.0.0.1:8088
# Puerto publicado por Docker Compose.
GAMECONSOLE_PORT=8088
